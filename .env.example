# Copy to .env and adjust if needed. All settings are optional.
# Relative paths are resolved from the project root.
# Never put real secrets in .env.example; .env itself is git-ignored.

TANYA_VIDEO_DIR=data/videos
TANYA_FRAMES_DIR=data/frames
TANYA_DB_PATH=data/tanya.db

# Seconds between extracted frames, 1.0 to 2.0
TANYA_FRAME_INTERVAL_SEC=1.0

# JPEG quality for extracted frames, 1 to 100
TANYA_JPEG_QUALITY=90
