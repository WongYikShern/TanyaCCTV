# Copy to .env and adjust if needed. All settings are optional.
# Relative paths are resolved from the project root.
# Never put real secrets in .env.example; .env itself is git-ignored.

TANYA_VIDEO_DIR=data/videos
TANYA_FRAMES_DIR=data/frames
TANYA_DB_PATH=data/tanya.db

# Seconds between extracted frames, 1.0 to 2.0
TANYA_FRAME_INTERVAL_SEC=1.0

# JPEG quality for extracted frames, 1 to 100
TANYA_JPEG_QUALITY=90

# ---------------------------------------------------------------- natural-language search (optional)
# Path to python.exe of the separate SentrySearch environment (Python 3.12, pinned d3efd6a).
# Leave empty to disable search. Example:
#   C:\Users\<you>\sentrysearch-trial\tools\sentrysearch\Scripts\python.exe
TANYA_SENTRY_PYTHON=

# Bridge script run inside that environment (relative to the project root).
TANYA_SENTRY_BRIDGE=search_engine/tanya_bridge.py

# Seconds before a search is abandoned.
TANYA_SEARCH_TIMEOUT_SEC=60

# Grouping of overlapping/adjacent 10 s chunks into one time window. Affects grouping only:
# every result is always "uncertain" (needs human review).
# 0.0 = merge every touching chunk, 1.0 = no merging of weaker chunks.
TANYA_MERGE_RATIO=0.5
# Allowed gap in seconds between chunks that are still merged.
TANYA_MERGE_GAP_SEC=0

# GEMINI_API_KEY is required for search and indexing. NEVER put a real key in this file.
# Set it in your terminal session ($env:GEMINI_API_KEY = ...) or in your own git-ignored .env:
# GEMINI_API_KEY=
