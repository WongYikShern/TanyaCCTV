# Hosted copy of the real website for judges: the approved public clips (deploy/hosted-library, staged by
# deploy/stage_hosted_library.py), footage-notes search, no API key and no SentrySearch.
# Build from the project root:  docker build -f deploy/Dockerfile.hosted -t tanyacctv-hosted .
FROM python:3.12-slim

WORKDIR /app
COPY backend/requirements.txt backend/requirements.txt
# imageio-ffmpeg ships a static FFmpeg binary; linking it onto PATH is much lighter than the apt package.
# Separate layers keep each upload small enough for a slow connection to push.
ENV PIP_NO_CACHE_DIR=1 PIP_DEFAULT_TIMEOUT=120 PIP_RETRIES=10
RUN pip install numpy
RUN pip install opencv-python-headless
# pytest is test-only, so it stays out of the image.
RUN grep -v '^pytest' backend/requirements.txt > /tmp/runtime.txt \
    && pip install -r /tmp/runtime.txt gunicorn
RUN pip install imageio-ffmpeg \
    && ln -s "$(python -c 'import imageio_ffmpeg; print(imageio_ffmpeg.get_ffmpeg_exe())')" /usr/local/bin/ffmpeg

COPY backend backend
COPY search_engine search_engine
COPY deploy/hosted-library /app/library
# The other twelve approved clips are tracked in data/videos (the sixteen together are the website library),
# so a build straight from GitHub has the whole library without running stage_hosted_library.py first.
COPY data/videos/ /app/library/videos/

ENV PYTHONUNBUFFERED=1 \
    TANYA_VIDEO_DIR=/app/library/videos \
    TANYA_FRAMES_DIR=/app/library/frames \
    TANYA_DB_PATH=/app/library/tanya.db \
    TANYA_DISABLE_UPLOADS=1 \
    PORT=5001

# Index at build time so the site starts with frames ready.
RUN cd backend && python -c "from tanya.config import load_settings; from tanya.indexer import Indexer; Indexer(load_settings()).run()"

# One worker: the CSRF secret, job lock and scan jobs live in process memory.
CMD ["sh", "-c", "exec gunicorn --chdir backend --workers 1 --threads 8 --timeout 120 --bind 0.0.0.0:$PORT 'tanya.web:create_app()'"]
